---
import 'bootstrap/dist/css/bootstrap.min.css';
import '../styles/custom.css';

const {
  title = 'NexGen Binary',
  description = 'NexGen Binary provides dental-focused managed IT, security, cloud, and support services across Virginia.',
  site
} = Astro.props;

const formEndpoint = site?.contact?.formEndpoint || '';
const assetBase = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');
const assetUrl = (path) => `${assetBase}${path}`;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const socialImageUrl = Astro.site ? new URL(assetUrl('nexgenbinary-logo.png'), Astro.site) : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta property="og:image:alt" content="NexGen Binary logo" />
    <meta name="twitter:card" content="summary_large_image" />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="shortcut icon" href={assetUrl('favicon.ico?v=20260712')} />
    <link rel="icon" type="image/svg+xml" href={assetUrl('favicon.svg?v=20260712')} />
    <link rel="icon" type="image/png" sizes="32x32" href={assetUrl('favicon-32x32.png?v=20260712')} />
    <link rel="icon" type="image/png" sizes="16x16" href={assetUrl('favicon-16x16.png?v=20260712')} />
    <link rel="apple-touch-icon" sizes="180x180" href={assetUrl('apple-touch-icon.png?v=20260712')} />
    <link rel="manifest" href={assetUrl('site.webmanifest?v=20260712')} />
    <meta name="theme-color" content="#0b2f53" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <script is:inline>
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.addEventListener('load', () => {
        try { window.scrollTo({ top: 0, left: 0, behavior: 'auto' }); } catch { window.scrollTo(0, 0); }
      });
    </script>
  </head>
  <body>
    <slot />
    <script is:inline define:vars={{ formEndpoint }}>
      window.__NEXGEN_FORM_ENDPOINT__ = formEndpoint;
    </script>
  </body>
</html>
